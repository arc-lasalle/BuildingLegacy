<Window x:Class="BLComponentTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building Legacy data exporter - Selección del componente"
        Height="600"
        Width="1000"
        MinHeight="450"
        MinWidth="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Exportación de fichas Excel"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Selecciona un tipo de componente o sistema y busca coincidencias en el modelo BIM activo."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="1. Tipo de componente" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Label escala -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>    <!-- Combo escala -->
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Label tipo -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="280"/>    <!-- Combo tipo -->
                    <ColumnDefinition Width="*"/>      <!-- espacio flexible -->
                    <ColumnDefinition Width="Auto"/>   <!-- Botón buscar -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Escala:"/>

                <ComboBox x:Name="ElementScaleComboBox"
                          Grid.Column="2"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          SelectionChanged="ElementScaleComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="4"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="Tipo:"/>

                <ComboBox x:Name="ComponentTypeComboBox"
                          Grid.Column="6"
                          MinWidth="280"
                          VerticalAlignment="Center"
                          SelectionChanged="ComponentTypeComboBox_SelectionChanged"/>       

                <Button x:Name="SearchMatchesButton"
                        Grid.Column="8"
                        Width="160"
                        Content="Buscar coincidencias"
                        Click="SearchMatchesButton_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="2. Modo de identificación" Padding="10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="PreciseModeCheckBox"
                          Content="Usar identificación precisa"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Si se desactiva, la búsqueda será más general (solo por categoría)."/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="CompositeModeGroupBox"
                    Grid.Row="6"
                    Header="Modo de exportación del componente compuesto"
                    Padding="10"
                    Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="CompositeAssemblyModeCheckBox"
                          Content="Exportar subcomponentes como un único componente"
                          IsChecked="True"
                          Checked="CompositeAssemblyModeCheckBox_Checked"
                          Unchecked="CompositeAssemblyModeCheckBox_Checked"
                          VerticalAlignment="Center"/>      
                <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Si se desactiva, cada subcomponente se tratará como componente independiente."/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="8" Header="3. Coincidencias encontradas" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tabla -->
                <DataGrid x:Name="MatchesDataGrid"
                  Grid.Row="0"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="MatchesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="1.2*"/>
                        <DataGridTextColumn Header="Familia" Binding="{Binding Family}" Width="2*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeName}" Width="2*"/>
                        <DataGridTextColumn Header="Dimensiones" Binding="{Binding DimensionsSignature}" Width="2*"/>
                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="1*"/>
                        <DataGridTextColumn Header="Instancias" Binding="{Binding InstanceCount}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Visor -->
                <Border Grid.Row="0"
                        Grid.Column="2"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="4">
                    <Grid>
                        <TextBlock x:Name="PreviewPlaceholderText"
                           Text="Selecciona un componente para visualizarlo"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="Gray"/>

                        <ContentControl x:Name="PreviewHost"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Grid.ColumnSpan="3"
                   Text="Aún no se ha ejecutado ninguna búsqueda."
                   FontStyle="Italic"/>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="10" LastChildFill="False">
            <Button x:Name="NextButton"
                    Content="Siguiente"
                    Width="120"
                    IsEnabled="False"
                    Click="NextButton_Click"
                    DockPanel.Dock="Right"
                    Margin="10,0,0,0"/>

            <Button Content="Cerrar"
                    Width="100"
                    Click="CloseButton_Click"
                    DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>