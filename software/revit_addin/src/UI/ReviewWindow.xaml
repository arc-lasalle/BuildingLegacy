<Window x:Class="BLComponentTemplate.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building Legacy data exporter - Revisión previa"
        Height="620"
        Width="1000"
        MinHeight="500"
        MinWidth="780"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>            
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Revisión previa a la exportación"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Revisa los datos detectados automáticamente. Puedes decidir cuáles exportar a la plantilla Excel."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Resumen del componente -->
        <GroupBox Grid.Row="2" Header="1. Resumen del componente seleccionado" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo de componente:" FontWeight="SemiBold"/>
                <TextBlock x:Name="ComponentTypeTextBlock" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Modo de búsqueda:" FontWeight="SemiBold"/>
                <TextBlock x:Name="SearchModeTextBlock" Grid.Row="0" Grid.Column="3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Categoría:" FontWeight="SemiBold"/>
                <TextBlock x:Name="CategoryTextBlock" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Familia:" FontWeight="SemiBold"/>
                <TextBlock x:Name="FamilyTextBlock" Grid.Row="2" Grid.Column="3"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tipo:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TypeNameTextBlock" Grid.Row="4" Grid.Column="1"/>

                <TextBlock Grid.Row="4" Grid.Column="2" Text="TypeId:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TypeIdTextBlock" Grid.Row="4" Grid.Column="3"/>
            </Grid>
        </GroupBox>        

        <!-- Tabla de datos exportables -->
        <GroupBox Grid.Row="4" Header="2. Datos exportables" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <DataGrid x:Name="ExportableParametersDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Exportar"
                                Binding="{Binding IsSelectedForExport}"
                                Width="90"/>

                        <DataGridTextColumn Header="Parámetro"
                            Binding="{Binding DisplayName}"
                            Width="2*"
                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Valor"
                            Binding="{Binding Value}"
                            Width="2*"
                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Unidades"
                            Width="1.2*"
                            IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Unit"
                                         TargetNullValue="NA"
                                         FallbackValue="NA"/>   
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Origen"
                            Binding="{Binding Source}"
                            Width="1.5*"
                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TemplateStatusTextBlock"
                           Grid.Row="2"
                           Text="No se ha importado todavía ninguna plantilla Excel."
                           FontStyle="Italic"/>
            </Grid>
        </GroupBox>

        <!-- Botones -->
        <DockPanel Grid.Row="6" LastChildFill="False">
            <Button x:Name="ExportIfcButton"
            Content="Exportación IFC"
            Width="140"
            Click="ExportIfcButton_Click"
            DockPanel.Dock="Right"
            Margin="10,0,0,0"/>

            <Button x:Name="ExportRfaButton"
            Content="Exportar familia (RFA)"
            Width="160"
            Click="ExportRfaButton_Click"
            DockPanel.Dock="Right"
            Margin="10,0,0,0"/>

            <Button x:Name="ExportDataButton"
            Content="Exportar datos"
            Width="130"
            Click="ExportDataButton_Click"
            DockPanel.Dock="Right"
            Margin="10,0,0,0"/>

            <Button x:Name="ImportTemplateButton"
            Content="Importar plantilla"
            Width="140"
            Click="ImportTemplateButton_Click"
            DockPanel.Dock="Right"
            Margin="10,0,0,0"/>

            <Button x:Name="BackButton"
            Content="Atrás"
            Width="100"
            Click="BackButton_Click"
            DockPanel.Dock="Left"/>
        </DockPanel>
    </Grid>
</Window>
